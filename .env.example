# Copy this file to .env for local development and fill in a real
# Postgres connection string (e.g. one from a free local Postgres install,
# or a free Render database you create for dev use). Never commit the
# real .env file -- it's already in .gitignore.
DATABASE_URL=postgresql://user:password@localhost:5432/myscape

# Signs website login session cookies. Generate a real one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# On Render this is auto-generated and persisted -- see render.yaml.
SESSION_SECRET_KEY=replace-me-with-a-random-value

# Session cookies are marked "secure" (HTTPS-only) by default, matching
# production. Uncomment if that ever gets in the way of local
# http://localhost testing -- don't turn this off in production.
# SESSION_COOKIE_HTTPS_ONLY=false
